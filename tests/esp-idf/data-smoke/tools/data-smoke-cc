#!/bin/sh
# ESP32 gcc wrapper for the C sources this example vendors (SQLite via
# libsqlite3-sys). Finds the toolchain esp-idf-sys installed — locally in
# .embuild by default, or wherever IDF_TOOLS_PATH points — and injects the
# empty sys/ioctl.h shim (newlib has no such header; SQLite includes it).
set -eu
example_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tools_root=${IDF_TOOLS_PATH:-$example_root/.embuild/espressif}
for compiler in \
    "$tools_root"/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-gcc
do
    if [ -x "$compiler" ]; then
        exec "$compiler" -isystem "$example_root/shim" "$@"
    fi
done
echo "ESP32 gcc is missing; build once so esp-idf-sys installs the toolchain (or set IDF_TOOLS_PATH)" >&2
exit 1
