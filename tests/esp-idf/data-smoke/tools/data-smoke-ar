#!/bin/sh
set -eu
example_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tools_root=${IDF_TOOLS_PATH:-$example_root/.embuild/espressif}
for ar in \
    "$tools_root"/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-ar
do
    if [ -x "$ar" ]; then
        exec "$ar" "$@"
    fi
done
echo "ESP32 ar is missing; build once so esp-idf-sys installs the toolchain (or set IDF_TOOLS_PATH)" >&2
exit 1
