{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.test-system-ui",
  "name": "test-system-ui",
  "title": "Test System UI",
  "version": "1.0.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "ui.compositor-surfaces"
      ],
      "enhances": []
    }
  },
  "app": {
    "entry": "tests/fixtures/system-ui.ts",
    "output": "test-system-ui",
    "framework": "solid",
    "companions": ["system-ui"],
    "viewport": {
      "dynamic": {
        "default": [800, 600],
        "min": [640, 480]
      }
    }
  }
}
