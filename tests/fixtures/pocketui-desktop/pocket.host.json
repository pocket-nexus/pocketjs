{
  "format": "pocket-host/2",
  "id": "pocketui-desktop-test",
  "platform": "macos",
  "form": "widget",
  "cadences": [
    60
  ],
  "display": {
    "logicalViewports": [
      [
        420,
        560
      ]
    ],
    "dynamicViewport": {
      "min": [
        240,
        180
      ],
      "max": [
        4096,
        4096
      ]
    },
    "presentations": [
      "native"
    ],
    "rasterDensity": 1,
    "animation": "composited"
  },
  "panel": {
    "primary": [
      420,
      560
    ]
  },
  "capabilities": [
    "display.viewport.live",
    "host.clipboard",
    "input.buttons",
    "input.ime",
    "input.pointer",
    "input.scroll",
    "input.text",
    "text.glyphs.baked",
    "text.glyphs.runtime"
  ]
}
