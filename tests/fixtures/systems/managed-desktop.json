{
  "$schema": "https://pocketjs.dev/schema/pocket-system-1.json",
  "pocketSystem": 1,
  "id": "dev.pocket-nexus.test-system",
  "name": "test-system",
  "title": "Test System",
  "version": "1.0.0",
  "roles": {
    "systemUI": "dev.pocket-nexus.test-system-ui"
  },
  "applications": {
    "installPolicy": {
      "model": "managed",
      "mutable": true
    },
    "backgroundExecution": "suspend",
    "catalog": [
      {
        "package": "dev.pocket-nexus.test-system-ui",
        "manifest": "tests/fixtures/manifests/system-ui.json",
        "required": true
      },
      {
        "package": "dev.pocket-nexus.hero",
        "manifest": "apps/hero/pocket.json",
        "required": false,
        "presentation": { "title": "Hero", "viewport": [640, 360] }
      },
      {
        "package": "dev.pocket-nexus.settings",
        "manifest": "apps/settings/pocket.json",
        "required": false,
        "presentation": { "title": "Settings", "viewport": [480, 272] }
      }
    ]
  },
  "installation": {
    "installedPackages": [
      "dev.pocket-nexus.test-system-ui",
      "dev.pocket-nexus.hero",
      "dev.pocket-nexus.settings"
    ]
  }
}
