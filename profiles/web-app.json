{
  "format": "pocket-profile/2",
  "id": "web-app",
  "platform": "web",
  "form": "window",
  "cadences": [60],
  "display": {
    "logicalViewports": [[800, 600]],
    "dynamicViewport": {
      "min": [320, 240],
      "max": [4096, 4096],
      "acceptsFixed": true
    },
    "presentations": ["native"],
    "rasterDensity": 1,
    "animation": "composited"
  },
  "panel": {
    "primary": [800, 600]
  },
  "capabilities": [
    "display.viewport.live",
    "input.buttons",
    "io.offload",
    "text.glyphs.baked",
    "text.glyphs.runtime",
    "text.layout.offload"
  ],
  "roleCapabilities": {
    "systemUI": ["ui.compositor-surfaces"]
  }
}
