{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.ipad2-demo",
  "name": "pocketjs-ipad2-hero",
  "title": "PocketJS: iPad 2,2",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/ipad2-demo/main.tsx",
    "output": "ipad2-demo-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [768, 1024],
        "presentation": "native"
      }
    }
  }
}
