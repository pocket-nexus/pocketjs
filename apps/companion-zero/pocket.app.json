{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.companion-zero",
  "title": "Pocket Companion",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons"]
    }
  },
  "app": {
    "entry": "apps/companion-zero/main.tsx",
    "output": "companion-zero-main",
    "framework": "solid",
    "tickHz": 30,
    "viewport": {
      "fixed": {
        "logical": [320, 170],
        "presentation": "native"
      }
    }
  },
  "domains": {
    "worker": {
      "entry": "apps/companion-zero/worker.ts",
      "nodes": [{ "name": "http", "kind": "http" }],
      "channels": [
        { "name": "request", "kind": "ring", "direction": "ui-to-worker", "recordBytes": 1024, "capacity": 4 },
        { "name": "response", "kind": "ring", "direction": "worker-to-ui", "recordBytes": 1024, "capacity": 8 }
      ]
    }
  }
}
