{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.text-cjk",
  "name": "pocketjs-text-cjk",
  "title": "PocketJS: Text Lab",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "text.glyphs.streamed",
        "io.offload",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "apps/text-cjk/main.tsx",
    "output": "text-cjk-main",
    "framework": "solid",
    "runtimeText": {
      "charset": "ascii"
    },
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
