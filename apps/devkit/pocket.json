{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.devkit",
  "name": "pocketjs-devkit",
  "title": "Pocket Devkit",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "apps/devkit/main.tsx",
    "output": "devkit-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 272],
        "presentation": "integer-fit"
      }
    }
  }
}
