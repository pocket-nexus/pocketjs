{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.music",
  "name": "pocketjs-music",
  "title": "PocketJS: Now Playing",
  "version": "0.6.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "audio.pcm"
      ]
    }
  },
  "app": {
    "entry": "apps/music/main.tsx",
    "output": "music-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    },
    "theme": {
      "keyframes": {
        "eq-bar-0": {
          "from": {
            "height": 6
          },
          "12.5%": {
            "height": 13.7
          },
          "25%": {
            "height": 20.1
          },
          "37.5%": {
            "height": 24.5
          },
          "50%": {
            "height": 26
          },
          "62.5%": {
            "height": 24.5
          },
          "75%": {
            "height": 20.1
          },
          "87.5%": {
            "height": 13.7
          },
          "to": {
            "height": 6
          }
        },
        "eq-bar-1": {
          "from": {
            "height": 25.8
          },
          "12.5%": {
            "height": 23.3
          },
          "25%": {
            "height": 18.2
          },
          "37.5%": {
            "height": 11.2
          },
          "50%": {
            "height": 8.6
          },
          "62.5%": {
            "height": 16
          },
          "75%": {
            "height": 21.8
          },
          "87.5%": {
            "height": 25.3
          },
          "to": {
            "height": 25.8
          }
        },
        "eq-bar-2": {
          "from": {
            "height": 11.1
          },
          "12.5%": {
            "height": 18.1
          },
          "25%": {
            "height": 23.3
          },
          "37.5%": {
            "height": 25.8
          },
          "50%": {
            "height": 25.3
          },
          "62.5%": {
            "height": 21.9
          },
          "75%": {
            "height": 16.1
          },
          "87.5%": {
            "height": 8.7
          },
          "to": {
            "height": 11.1
          }
        },
        "eq-bar-3": {
          "from": {
            "height": 24.5
          },
          "12.5%": {
            "height": 20.2
          },
          "25%": {
            "height": 13.7
          },
          "37.5%": {
            "height": 6.1
          },
          "50%": {
            "height": 13.6
          },
          "62.5%": {
            "height": 20.1
          },
          "75%": {
            "height": 24.4
          },
          "87.5%": {
            "height": 26
          },
          "to": {
            "height": 24.5
          }
        }
      },
      "animation": {
        "eq0": {
          "value": "eq-bar-0 350ms linear both",
          "loop": "350ms"
        },
        "eq1": {
          "value": "eq-bar-1 350ms linear both",
          "loop": "350ms"
        },
        "eq2": {
          "value": "eq-bar-2 350ms linear both",
          "loop": "350ms"
        },
        "eq3": {
          "value": "eq-bar-3 350ms linear both",
          "loop": "350ms"
        }
      }
    }
  }
}
