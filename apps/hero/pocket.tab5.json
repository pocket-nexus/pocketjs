{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.hero",
  "name": "pocketjs-hero",
  "title": "PocketJS: Hero",
  "version": "0.6.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.touch"
      ]
    }
  },
  "app": {
    "entry": "apps/hero/main.tsx",
    "output": "hero-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          640,
          360
        ],
        "presentation": "native"
      }
    },
    "aot": true,
    "model": "compiled"
  }
}
