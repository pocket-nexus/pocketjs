{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.game2d-pack-demo",
  "title": "PocketJS: Pack Demo",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "audio.pcm",
        "data.fs",
        "data.pack"
      ]
    }
  },
  "app": {
    "entry": "apps/game2d-pack-demo/main.tsx",
    "output": "game2d-pack-demo",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
