{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.sortie",
  "name": "pocketjs-sortie",
  "title": "PocketJS: Pocket Sortie",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "audio.pcm"
      ]
    }
  },
  "app": {
    "entry": "apps/sortie/main.tsx",
    "output": "sortie-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
