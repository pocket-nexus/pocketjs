{
  "keyframes": {
    "bob": {
      "from": {
        "transform": "translateY(0px) rotate(0deg)"
      },
      "50%": {
        "transform": "translateY(-0.9px) rotate(0.8deg)"
      },
      "to": {
        "transform": "translateY(0px) rotate(0deg)"
      }
    },
    "breathe": {
      "from": {
        "transform": "scaleX(1) scaleY(1)"
      },
      "50%": {
        "transform": "scaleX(0.993) scaleY(1.014)"
      },
      "to": {
        "transform": "scaleX(1) scaleY(1)"
      }
    },
    "nudge": {
      "from": {
        "transform": "translateY(0px)"
      },
      "50%": {
        "transform": "translateY(5px)"
      },
      "to": {
        "transform": "translateY(0px)"
      }
    }
  },
