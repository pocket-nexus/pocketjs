{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.meizu-m8-demo",
  "name": "pocketjs-meizu-m8-hero",
  "title": "PocketJS: Meizu M8 Hero",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/meizu-m8-demo/main.tsx",
    "output": "meizu-m8-demo-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 720],
        "presentation": "native"
      }
    }
  }
}
