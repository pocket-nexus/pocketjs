{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.nexus-touch",
  "name": "pocketjs-nexus-touch",
  "title": "Pocket Nexus",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "input.touch",
        "ui.physics"
      ]
    }
  },
  "app": {
    "entry": "apps/nexus-touch/main.tsx",
    "output": "nexus-touch-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [320, 480],
        "presentation": "native"
      }
    }
  }
}
