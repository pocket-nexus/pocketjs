#!/bin/bash
set -euo pipefail

manifest=/opt/pocketjs/symbian-toolchain.json
: "${POCKETJS_SYMBIAN_IMPLEMENTATION_SHA256:?implementation digest is required}"
: "${POCKETJS_SYMBIAN_IMAGE_IMPLEMENTATION_SHA256:?image implementation digest is required}"
if test "$POCKETJS_SYMBIAN_IMAGE_IMPLEMENTATION_SHA256" != \
    "$POCKETJS_SYMBIAN_IMPLEMENTATION_SHA256"; then
    echo "Symbian image and checkout implementation digests do not match." >&2
    exit 1
fi

if test "$#" != 6; then
    echo "usage: pocketjs-symbian-build-app <output-name> <sis-version> <data-base> <embedded-bytes> <frame-rate> <perf-trace>" >&2
    exit 1
fi
app_output=$1
sis_version=$2
data_base=$3
embedded_bytes=$4
frame_rate=$5
perf_trace=$6
if [[ ! "$frame_rate" =~ ^(1|2|3|4|5|6|10|12|15|20|30|60)$ ]] ||
    [[ ! "$perf_trace" =~ ^[01]$ ]]; then
    echo "Invalid frame rate or performance trace option." >&2
    exit 1
fi
if [[ ! "$app_output" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Unsafe PocketJS app output name: $app_output" >&2
    exit 1
fi
if [[ ! "$sis_version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    echo "SIS version must be three decimal components (for example 1.0.0)." >&2
    exit 1
fi
sis_major=${BASH_REMATCH[1]}
sis_minor=${BASH_REMATCH[2]}
sis_build=${BASH_REMATCH[3]}
for component in "$sis_major" "$sis_minor" "$sis_build"; do
    if (( component > 32767 )); then
        echo "Every SIS version component must be at most 32767." >&2
        exit 1
    fi
done
if [[ ! "$data_base" =~ ^0x[0-9a-f]+$ ]] ||
    (( data_base < 0x400000 )) ||
    (( data_base > 0x10000000 )) ||
    (( data_base % 0x100000 != 0 )); then
    echo "Symbian data base must be an aligned lowercase hex address from 0x400000 through 0x10000000." >&2
    exit 1
fi
if [[ ! "$embedded_bytes" =~ ^[0-9]+$ ]]; then
    echo "Symbian embedded byte count must be a decimal integer." >&2
    exit 1
fi

toolchain=/toolchain/current
payload="/out/build/$app_output"
runtime_source=/workspace/hosts/nokia-e7/runtime
rust_library="$payload/libpocketjs_symbian_core.a"
package_json="$payload/package.json"
quickjs_asset="/downloads/$(jq -r .quickjs.asset "$manifest")"
quickjs_sha256=$(jq -r .quickjs.sha256 "$manifest")
quickjs_version=$(jq -r .quickjs.version "$manifest")
quickjs_revision=$(jq -r .quickjs.rev "$manifest")
if test ! -s "$package_json"; then
    echo "Missing Symbian package identity: $package_json" >&2
    exit 1
fi
uid=$(jq -er '.uid | strings | select(test("^0xE[0-9A-F]{7}$"))' "$package_json")
package_title=$(jq -er \
    '.title | strings |
     select(test("^[A-Za-z0-9][A-Za-z0-9 ._+&():-]{0,127}$"))' \
    "$package_json")
executable=$(jq -er \
    '.executable | strings | select(test("^[A-Za-z][A-Za-z0-9]{0,30}$"))' \
    "$package_json")
output_name=$(jq -er \
    '.sisFile | strings | select(test("^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.sis$"))' \
    "$package_json")
output="/out/$output_name"
receipt_name=$(jq -er \
    '.receiptFile | strings | select(test("^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.receipt\\.json$"))' \
    "$package_json")
receipt="/out/$receipt_name"
catalog_index="$payload/catalog.tsv"
catalog_blob="$payload/catalog.bin"
catalog_enabled=false
if test -e "$catalog_index" || test -e "$catalog_blob"; then
    if test ! -s "$catalog_index" || test ! -s "$catalog_blob"; then
        echo "Symbian app catalog requires non-empty catalog.tsv and catalog.bin." >&2
        exit 1
    fi
    catalog_enabled=true
fi
data_stage="$payload/mass-storage-data"
data_manifest="$data_stage/manifest.json"
data_files="$data_stage/files"
data_enabled=false
if test -e "$data_stage"; then
    if test -L "$data_stage" || test ! -d "$data_stage" ||
        test -L "$data_manifest" || test ! -f "$data_manifest" ||
        test -L "$data_files" || test ! -d "$data_files"; then
        echo "Symbian mass-storage data stage is incomplete or unsafe." >&2
        exit 1
    fi
    if find "$data_files" -mindepth 1 \
        \( -type l -o \( ! -type d ! -type f \) \) \
        -print -quit | grep -q .; then
        echo "Symbian mass-storage data contains a symlink or non-regular file." >&2
        exit 1
    fi
    if ! jq -e '
        .schemaVersion == 1 and
        keys == ["data", "schemaVersion"] and
        (.data | type == "array" and length > 0) and
        all(.data[];
          keys == ["bytes", "path", "sha256"] and
          (.path | type == "string" and length > 0 and length <= 200 and
            test("^[A-Za-z0-9_-](?:[A-Za-z0-9._ -]{0,62}[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-](?:[A-Za-z0-9._ -]{0,62}[A-Za-z0-9_-])?)*$")) and
          (.bytes | type == "number" and . >= 0 and . <= 9007199254740991 and floor == .) and
          (.sha256 | type == "string" and test("^[a-f0-9]{64}$"))
        ) and
        ([.data[].path] == ([.data[].path] | sort)) and
        (([.data[].path | ascii_downcase] | length) ==
          ([.data[].path | ascii_downcase] | unique | length))
      ' "$data_manifest" >/dev/null; then
        echo "Symbian mass-storage data manifest is invalid." >&2
        exit 1
    fi
    expected_data_count=$(jq -r '.data | length' "$data_manifest")
    actual_data_count=$(
        find "$data_files" -type f -printf '%p\n' |
            wc -l |
            tr -d '[:space:]'
    )
    if test "$actual_data_count" != "$expected_data_count"; then
        echo "Symbian mass-storage data manifest does not cover the staged file set." >&2
        exit 1
    fi
    while IFS= read -r encoded; do
        record=$(printf '%s' "$encoded" | base64 -d)
        relative_path=$(jq -er '.path' <<<"$record")
        expected_bytes=$(jq -er '.bytes' <<<"$record")
        expected_sha256=$(jq -er '.sha256' <<<"$record")
        staged_file="$data_files/$relative_path"
        if test -L "$staged_file" || test ! -f "$staged_file"; then
            echo "Missing staged Symbian mass-storage data: $relative_path" >&2
            exit 1
        fi
        actual_bytes=$(stat -c %s "$staged_file")
        actual_sha256=$(sha256sum "$staged_file" | cut -d " " -f 1)
        if test "$actual_bytes" != "$expected_bytes" ||
            test "$actual_sha256" != "$expected_sha256"; then
            echo "Staged Symbian mass-storage data failed verification: $relative_path" >&2
            exit 1
        fi
    done < <(jq -r '.data[] | @base64' "$data_manifest")
    data_enabled=true
fi
actual_embedded_bytes=$(
    stat -c %s "$payload/app.js" "$payload/app.pak" |
        awk '{ total += $1 } END { print total + 0 }'
)
if test "$catalog_enabled" = true; then
    actual_embedded_bytes=$(
        {
            printf '%s\n' "$actual_embedded_bytes"
            stat -c %s "$catalog_index" "$catalog_blob"
        } | awk '{ total += $1 } END { print total + 0 }'
    )
fi
if test "$actual_embedded_bytes" != "$embedded_bytes"; then
    echo "Symbian embedded payload changed after link layout resolution." >&2
    exit 1
fi
certificate="/signing/$(jq -r .signing.certificate "$manifest")"
private_key="/signing/$(jq -r .signing.privateKey "$manifest")"
lock=/toolchain/.toolchain.lock

for required in \
    "$payload/app.js" \
    "$payload/app.pak" \
    "$payload/plan.json" \
    "$package_json" \
    "$rust_library"; do
    if test ! -s "$required"; then
        echo "Missing Symbian runtime input: $required" >&2
        exit 1
    fi
done
echo "$quickjs_sha256  $quickjs_asset" | sha256sum --check --status

if ! initial_logical_width=$(jq -er '.viewport.logical[0]' "$payload/plan.json") ||
    ! initial_logical_height=$(jq -er '.viewport.logical[1]' "$payload/plan.json"); then
    echo "Symbian build plan is missing viewport.logical width/height." >&2
    exit 1
fi
if ! host_abi=$(jq -er '.target.hostAbi' "$payload/plan.json"); then
    echo "Symbian build plan is missing target.hostAbi." >&2
    exit 1
fi
if [[ ! "$host_abi" =~ ^[1-9][0-9]*$ ]] ||
    (( 10#$host_abi > 2147483647 )); then
    echo "Symbian target.hostAbi must be a positive 32-bit integer." >&2
    exit 1
fi
if [[ ! "$initial_logical_width" =~ ^[1-9][0-9]*$ ]] ||
    [[ ! "$initial_logical_height" =~ ^[1-9][0-9]*$ ]] ||
    (( 10#$initial_logical_width > 640 )) ||
    (( 10#$initial_logical_height > 640 )); then
    echo "Symbian logical viewport must contain integer extents from 1 through 640." >&2
    exit 1
fi

if test ! -f "$lock"; then
    echo "Symbian toolchain lock is missing; run setup --yes." >&2
    exit 1
fi
exec 9<"$lock"
if ! flock --shared --timeout 120 9; then
    echo "Timed out waiting for the Symbian toolchain setup lock." >&2
    exit 1
fi

POCKETJS_SYMBIAN_LOCK_HELD=1 /usr/local/bin/pocketjs-symbian-doctor >/dev/null

build=$(mktemp -d /tmp/pocketjs-symbian-runtime.XXXXXX)
quickjs_root="$build/quickjs-rs"
quickjs_objects="$build/quickjs-objects"
output_stage=$(mktemp -d /out/.pocketjs-symbian-runtime.XXXXXX)
candidate="$output_stage/$output_name"
candidate_receipt="$output_stage/$receipt_name"
data_receipt="$build/mass-storage-data-receipt.json"

cleanup() {
    rm -rf "$build" "$output_stage"
}
trap cleanup EXIT

if test "$data_enabled" = true; then
    jq '.data' "$data_manifest" > "$data_receipt"
else
    printf '[]\n' > "$data_receipt"
fi

mkdir -p "$quickjs_root" "$quickjs_objects"
tar -xzf "$quickjs_asset" --strip-components=1 -C "$quickjs_root"
patch \
    --batch \
    --forward \
    -d "$quickjs_root" \
    -p1 \
    < /opt/pocketjs/patches/quickjs-symbian-gcce.patch
quickjs_source="$quickjs_root/libquickjs-sys/embed/quickjs"

export EPOCROOT="$toolchain/sdk/"
export PATH="$toolchain/sdk/bin:$toolchain/bin:$toolchain/gcce/arm-2012.03/bin:$PATH"
export QMAKESPEC=symbian-gcce

compiler_include=$(arm-none-symbianelf-gcc -print-file-name=include)
quickjs_flags=(
    -march=armv5t
    -mapcs
    -mthumb-interwork
    -nostdinc
    -mfloat-abi=softfp
    -mfpu=vfp
    "--include=${EPOCROOT}epoc32/include/gcce/gcce.h"
    -include "${EPOCROOT}mkspecs/common/symbian/symbianincludes.h"
    -D__GCCE__
    -DUNICODE
    -D__SYMBIAN32__
    -D__MARM_INTERWORK__
    -D_UNICODE
    -D__S60_50__
    -D__S60_3X__
    -D__SERIES60_3X__
    -D__EPOC32__
    -D__MARM__
    -D__EABI__
    -D__MARM_ARMV5__
    -D__SUPPORT_CPP_EXCEPTIONS__
    "-I${EPOCROOT}epoc32/include"
    "-I${EPOCROOT}epoc32/include/variant"
    "-I${EPOCROOT}epoc32/include/stdapis"
    "-I${EPOCROOT}epoc32/include/gcce"
    "-I${compiler_include}"
    "-I${quickjs_source}"
    -O2
    -fwrapv
    -fno-strict-aliasing
)
for source in cutils.c dtoa.c libregexp.c libunicode.c quickjs.c; do
    arm-none-symbianelf-gcc \
        "${quickjs_flags[@]}" \
        -std=gnu99 \
        -funsigned-char \
        -D_GNU_SOURCE \
        "-DCONFIG_VERSION=\"$quickjs_version\"" \
        -c "$quickjs_source/$source" \
        -o "$quickjs_objects/${source%.c}.o"
done
arm-none-symbianelf-gcc \
    "${quickjs_flags[@]}" \
    -std=gnu99 \
    -funsigned-char \
    -D_GNU_SOURCE \
    "-DCONFIG_VERSION=\"$quickjs_version\"" \
    -c "$quickjs_root/libquickjs-sys/embed/static-functions.c" \
    -o "$quickjs_objects/static-functions.o"
arm-none-symbianelf-ar cqs "$build/libquickjs.a" "$quickjs_objects"/*.o

cp "$runtime_source"/* "$build/"
cp "$payload/app.js" "$payload/app.pak" "$build/"
if test "$catalog_enabled" = true; then
    cp "$catalog_index" "$build/catalog.tsv"
    cp "$catalog_blob" "$build/catalog.bin"
fi
cd "$build"

qmake \
    -spec "$toolchain/sdk/mkspecs/symbian-gcce" \
    "POCKETJS_SYMBIAN_UID=$uid" \
    "POCKETJS_SYMBIAN_TARGET=$executable" \
    "POCKETJS_SYMBIAN_CAPTION=$package_title" \
    "POCKETJS_QUICKJS_INCLUDE=$quickjs_source" \
    "POCKETJS_QUICKJS_LIBRARY=$build/libquickjs.a" \
    "POCKETJS_CORE_LIBRARY=$rust_library" \
    "POCKETJS_FRAME_RATE=$frame_rate" \
    "POCKETJS_PERF_TRACE=$perf_trace" \
    "POCKETJS_HOST_ABI=$host_abi" \
    "POCKETJS_INITIAL_LOGICAL_WIDTH=$initial_logical_width" \
    "POCKETJS_INITIAL_LOGICAL_HEIGHT=$initial_logical_height" \
    "QMAKE_${executable}_LFLAGS=-Ttext 0x80000 -Tdata $data_base" \
    pocketjs-e7-runtime.pro
make -j2

expected_uid=$(tr "[:upper:]" "[:lower:]" <<<"${uid#0x}" | tr -d "[:space:]")
actual_uid=$(od -An -tx4 -j8 -N4 "$executable.exe" | tr -d "[:space:]")
test "$actual_uid" = "$expected_uid"
file "$executable.exe" | grep -Fq "Psion Series 5 executable"

cat > pocketjs-e7-runtime.pkg <<EOF
; Generated by pocketjs-symbian-build-app.
&EN
#{"$package_title"},($uid),$sis_major,$sis_minor,$sis_build
%{"Pocket Stack"}
:"Pocket Stack"
(0x2001E61C),4,7,4,{"Qt"}
[0x20022E6D],0,0,0,{"Symbian^3"}
[0x20032DE7],0,0,0,{"Symbian Belle"}
"$executable.exe"-"!:\\sys\\bin\\$executable.exe"
"$executable.rsc"-"!:\\resource\\apps\\$executable.rsc"
"${executable}_reg.rsc"-"!:\\private\\10003a3f\\import\\apps\\${executable}_reg.rsc"
EOF
if test "$data_enabled" = true; then
    uid_directory=${uid#0x}
    while IFS= read -r encoded; do
        record=$(printf '%s' "$encoded" | base64 -d)
        relative_path=$(jq -er '.path' <<<"$record")
        staged_file="$data_files/$relative_path"
        destination_path=${relative_path//\//\\}
        printf '"%s"-"E:\\private\\%s\\data\\%s"\n' \
            "$staged_file" \
            "$uid_directory" \
            "$destination_path" \
            >> pocketjs-e7-runtime.pkg
    done < <(jq -r '.data[] | @base64' "$data_manifest")
fi

makesis pocketjs-e7-runtime.pkg pocketjs-e7-runtime-unsigned.sis
signsis \
    pocketjs-e7-runtime-unsigned.sis \
    "$candidate" \
    "$certificate" \
    "$private_key"

test -s "$candidate"
file "$candidate" | grep -Fq "Symbian installation file"
signsis -o "$candidate" > "$build/signing.txt"
grep -Fq "Issued to:" "$build/signing.txt"

app_js_sha256=$(sha256sum "$payload/app.js" | cut -d " " -f 1)
app_pak_sha256=$(sha256sum "$payload/app.pak" | cut -d " " -f 1)
plan_sha256=$(sha256sum "$payload/plan.json" | cut -d " " -f 1)
core_sha256=$(sha256sum "$rust_library" | cut -d " " -f 1)
catalog_index_sha256=
catalog_blob_sha256=
if test "$catalog_enabled" = true; then
    catalog_index_sha256=$(sha256sum "$catalog_index" | cut -d " " -f 1)
    catalog_blob_sha256=$(sha256sum "$catalog_blob" | cut -d " " -f 1)
fi
jq -n \
    --arg app "$app_output" \
    --arg appId "$(jq -r .appId "$package_json")" \
    --arg title "$package_title" \
    --arg uid "$uid" \
    --arg executable "$executable.exe" \
    --arg sisVersion "$sis_version" \
    --arg quickjsVersion "$quickjs_version" \
    --arg quickjsRevision "$quickjs_revision" \
    --argjson frameRate "$frame_rate" \
    --argjson perfTrace "$perf_trace" \
    --arg appJsSha256 "$app_js_sha256" \
    --arg appPakSha256 "$app_pak_sha256" \
    --arg planSha256 "$plan_sha256" \
    --arg coreSha256 "$core_sha256" \
    --arg catalogIndexSha256 "$catalog_index_sha256" \
    --arg catalogBlobSha256 "$catalog_blob_sha256" \
    --arg dataBase "$data_base" \
    --arg embeddedBytes "$embedded_bytes" \
    --slurpfile data "$data_receipt" \
    '{
      schemaVersion: 3,
      app: $app,
      appId: $appId,
      title: $title,
      uid: $uid,
      executable: $executable,
      sisVersion: $sisVersion,
      quickjs: {version: $quickjsVersion, revision: $quickjsRevision, optimization: "O2"},
      runtime: {frameRate: $frameRate, perfTrace: ($perfTrace == 1), floatingPoint: "vfpv2-softfp"},
      link: {
        dataBase: $dataBase,
        embeddedBytes: ($embeddedBytes | tonumber)
      },
      sha256: {
        appJs: $appJsSha256,
        appPak: $appPakSha256,
        plan: $planSha256,
        core: $coreSha256,
        catalogIndex: (if $catalogIndexSha256 == "" then null else $catalogIndexSha256 end),
        catalogBlob: (if $catalogBlobSha256 == "" then null else $catalogBlobSha256 end)
      },
      data: $data[0]
    }' > "$candidate_receipt"

mv -f "$candidate" "$output"
mv -f "$candidate_receipt" "$receipt"

file "$executable.exe" "$output"
sha256sum "$output"
