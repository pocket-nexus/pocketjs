{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketjs.dev/schema/pocket-2.json",
  "title": "Pocket application manifest, format 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "pocket",
    "id",
    "title",
    "version",
    "engine",
    "app"
  ],
  "properties": {
    "$schema": {
      "const": "https://pocketjs.dev/schema/pocket-2.json"
    },
    "pocket": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.png$"
    },
    "applet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requires"
          ],
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "enhances": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "nodes"
          ],
          "properties": {
            "entry": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.ts$"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                  },
                  "kind": {
                    "enum": [
                      "i2c",
                      "uart",
                      "http"
                    ]
                  }
                }
              }
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind",
                  "direction",
                  "recordBytes",
                  "capacity"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                  },
                  "kind": {
                    "enum": [
                      "snapshot",
                      "ring"
                    ]
                  },
                  "direction": {
                    "enum": [
                      "ui-to-worker",
                      "worker-to-ui"
                    ]
                  },
                  "recordBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  }
                }
              }
            }
          }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "framework",
        "viewport"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.tsx?$"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "framework": {
          "enum": [
            "solid",
            "vue-vapor",
            "octane"
          ]
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "aot": {
          "type": "boolean"
        },
        "model": {
          "enum": [
            "rust",
            "compiled"
          ]
        },
        "recursionLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 256
        },
        "tickHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 60
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "auxiliary"
          ],
          "properties": {
            "auxiliary": {
              "type": "object",
              "additionalProperties": false,
              "description": "Exactly one of fixed and adaptive (checked at resolution).",
              "properties": {
                "fixed": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "logical",
                    "presentation"
                  ],
                  "properties": {
                    "logical": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "presentation": {
                      "enum": [
                        "fill",
                        "fit",
                        "integer-fit",
                        "native",
                        "stretch"
                      ]
                    }
                  }
                },
                "adaptive": {
                  "type": "object",
                  "additionalProperties": false,
