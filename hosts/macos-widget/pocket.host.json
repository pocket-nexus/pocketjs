{
  "format": "pocket-host/2",
  "id": "macos-widget",
  "platform": "macos",
  "form": "widget",
  "cadences": [60],
  "display": {
    "logicalViewports": [[420, 560]],
    "dynamicViewport": {
      "min": [240, 180],
      "max": [4096, 4096]
    },
    "presentations": ["native"],
    "rasterDensity": 2,
    "animation": "composited"
  },
  "panel": {
    "primary": [840, 1120]
  },
  "capabilities": [
    "display.viewport.live",
    "host.clipboard",
    "input.buttons",
    "input.ime",
    "input.pointer",
    "input.text",
    "text.glyphs.baked",
    "text.glyphs.runtime"
  ]
}
