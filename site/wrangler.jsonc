{
  // PocketJS site — an assets-only Worker (Workers Static Assets, no server
  // script). Serves site/dist. Deploy from the repo root:
  //   bunx wrangler deploy -c site/wrangler.jsonc
  // `directory` is resolved relative to THIS file, so it points at site/dist.
  "name": "pocketjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // /docs/overview/ -> /docs/overview/index.html
    "html_handling": "auto-trailing-slash",
    // unknown paths -> the branded /404.html
    "not_found_handling": "404-page"
  },
  // PocketJS lives at pocketjs.pocket.nexus, under the Pocket Nexus homepage
  // (site/nexus/wrangler.jsonc owns pocket.nexus and www.pocket.nexus), and
  // keeps serving pocketjs.dev and its www host. Wrangler provisions each
  // custom domain and edge certificate on deploy; in CI it also detaches any
  // custom domain of this Worker that is no longer listed here.
  "routes": [
    { "pattern": "pocketjs.dev", "custom_domain": true },
    { "pattern": "www.pocketjs.dev", "custom_domain": true },
    { "pattern": "pocketjs.pocket.nexus", "custom_domain": true }
  ]
}
