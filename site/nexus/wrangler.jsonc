{
  // pocket.nexus — the Pocket Nexus homepage, an assets-only Worker (Workers
  // Static Assets, no server script) serving site/nexus/public. PocketJS is a
  // separate Worker (site/wrangler.jsonc) at pocketjs.pocket.nexus and
  // pocketjs.dev. Deploy from the repo root:
  //   bunx wrangler deploy -c site/nexus/wrangler.jsonc
  // `directory` is resolved relative to THIS file, so it points at
  // site/nexus/public.
  "name": "pocket-nexus",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    // unknown paths -> the branded /404.html
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "pocket.nexus", "custom_domain": true },
    { "pattern": "www.pocket.nexus", "custom_domain": true }
  ]
}
